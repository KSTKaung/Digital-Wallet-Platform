# Local development only. Copy to .env and set your own values; .env is gitignored.
# Never reuse these values outside local development (documentations/06 §4).

# Password of the PostgreSQL bootstrap superuser "wallet" (used only by the postgres container).
POSTGRES_SUPERUSER_PASSWORD=change-me

# Passwords of the two database roles, created by infra/postgres/init/01-create-roles.sh on the
# first start of an empty volume. wallet_owner runs the Flyway migrations; wallet_app is the
# backend's runtime role (documentations/06 MVP-ADR-02).
WALLET_OWNER_PASSWORD=change-me
WALLET_APP_PASSWORD=change-me

# Host port for PostgreSQL. Change it (e.g. 55432) if a local PostgreSQL already listens on 5432.
POSTGRES_HOST_PORT=5432

# Spring profile for the backend container. "local" enables the OpenAPI docs at /v3/api-docs.
SPRING_PROFILES_ACTIVE=local

# Required secrets (documentations/06 MVP-ADR-23); the backend refuses to start with these
# placeholders. Replace all four with the lines printed by scripts/generate-dev-secrets.sh.
# JWT_PRIVATE_KEY is an RSA private key as single-line base64 of its PKCS#8 DER encoding, without
# PEM markers. OTP_HMAC_SECRET and REFRESH_TOKEN_PEPPER are base64 of at least 32 random bytes.
JWT_PRIVATE_KEY=generate-with-scripts/generate-dev-secrets.sh
JWT_KID=generate-with-scripts/generate-dev-secrets.sh
OTP_HMAC_SECRET=generate-with-scripts/generate-dev-secrets.sh
REFRESH_TOKEN_PEPPER=generate-with-scripts/generate-dev-secrets.sh

# Optional staff accounts, created at startup if set and absent; an existing account is never
# changed (documentations/08 Q8). Set both of a pair. Passwords follow the normal password policy.
# STAFF_ADMIN_EMAIL=
# STAFF_ADMIN_PASSWORD=
# STAFF_COMPLIANCE_EMAIL=
# STAFF_COMPLIANCE_PASSWORD=

# Optional: free NVD API key for faster OWASP Dependency-Check updates (./mvnw -Psecurity verify).
# NVD_API_KEY=
