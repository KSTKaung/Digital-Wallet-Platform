# Local development only. Copy to .env and set your own values; .env is gitignored.
# Never reuse these values outside local development (documentations/06 §4).

# Password of the PostgreSQL bootstrap superuser "wallet" (used only by the postgres container).
POSTGRES_SUPERUSER_PASSWORD=change-me

# Passwords of the two database roles, created by infra/postgres/init/01-create-roles.sh on the
# first start of an empty volume. wallet_owner runs the Flyway migrations; wallet_app is the
# backend's runtime role (documentations/06 MVP-ADR-02).
WALLET_OWNER_PASSWORD=change-me
WALLET_APP_PASSWORD=change-me

# Host port for PostgreSQL. Change it (e.g. 55432) if a local PostgreSQL already listens on 5432.
POSTGRES_HOST_PORT=5432

# Spring profile for the backend container. "local" enables the OpenAPI docs at /v3/api-docs.
SPRING_PROFILES_ACTIVE=local

# Optional: free NVD API key for faster OWASP Dependency-Check updates (./mvnw -Psecurity verify).
# NVD_API_KEY=
